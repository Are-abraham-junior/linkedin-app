# ==============================================================================
# Bime Link / Bleadin — Configuration de Déploiement & Télé-maintenance cPanel LWS
# ==============================================================================
# Copiez ce fichier vers .env.deploy et renseignez vos informations d'accès.
# Ce fichier .env.deploy contient des informations sensibles et EST IGNORÉ par git.

# --- 1. Paramètres de Connexion SSH LWS ---
# Hôte SSH fourni par LWS (nom de domaine ou IP du serveur cPanel)
SSH_HOST=votre-serveur.lws-hosting.com

# Port SSH (22 par défaut, ou port personnalisé LWS ex: 2222)
SSH_PORT=22

# Nom d'utilisateur cPanel / SSH
SSH_USER=votre_utilisateur_cpanel

# Chemin vers la clé privée SSH locale (recommandé pour une connexion sans mot de passe)
# Exemple Windows : C:/Users/ASUS/.ssh/id_rsa ou ~/.ssh/id_rsa
SSH_KEY_PATH=~/.ssh/id_rsa

# Mot de passe SSH (optionnel si clé SSH utilisée)
SSH_PASSWORD=

# --- 2. Chemins Distants sur le Serveur cPanel LWS ---
# Répertoire racine de l'API Node.js sur le serveur cPanel
# Confirmé via cPanel "Setup Node.js App" (Racine de l'application)
REMOTE_API_DIR=~/public_html/api-bleadin

# Répertoire racine du Frontend Web (fichiers statiques React / Vite)
# = racine du domaine bleadin.com. À reconfirmer en SSH avant le tout premier
# push client (ls -la ~/public_html) si l'arborescence cPanel a changé.
REMOTE_CLIENT_DIR=~/public_html

# Chemin vers le script d'activation nodevenv généré par cPanel "Setup Node.js App"
# Confirmé : Node 24.x, miroir de REMOTE_API_DIR
REMOTE_NODEVENV_PATH=~/nodevenv/public_html/api-bleadin/24/bin/activate

# --- 3. URLs Publiques de Validation & Recette ---
# Endpoint de vérification de santé de l'API
API_HEALTH_URL=https://api.bleadin.com/api/health

# URL publique du Frontend React
FRONTEND_URL=https://bleadin.com
